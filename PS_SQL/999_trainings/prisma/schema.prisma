generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 2 application models. The native SQL baseline remains authoritative for
// RLS policies, immutable ledger tables, and tables not yet used by the API.

model User {
  id               Int       @id @default(autoincrement())
  publicId         String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  email            String    @db.VarChar(255)
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  fullName         String?   @map("full_name") @db.VarChar(150)
  language         String    @default("en") @db.VarChar(5)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz
  accountStatus    String    @default("active") @map("account_status") @db.VarChar(20)
  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz
  suspensionReason String?   @map("suspension_reason")
  avatarFileId     Int?      @unique @map("avatar_file_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  @@map("users")
}

model Organization {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  name      String    @db.VarChar(150)
  slug      String    @db.VarChar(100)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("organizations")
}

model OrganizationMembership {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  userId         Int      @map("user_id")
  status         String   @default("active") @db.VarChar(20)
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

model OrganizationRole {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String   @db.VarChar(80)
  isSystem       Boolean  @default(false) @map("is_system")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("organization_roles")
}

model AuthSession {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId       Int       @map("user_id")
  deviceLabel  String?   @map("device_label") @db.VarChar(150)
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason") @db.VarChar(100)

  @@map("auth_sessions")
}

model RefreshToken {
  id                Int       @id @default(autoincrement())
  sessionId         Int       @map("session_id")
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  parentTokenId     Int?      @map("parent_token_id")
  replacedByTokenId Int?      @unique @map("replaced_by_token_id")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  usedAt            DateTime? @map("used_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  reuseDetectedAt   DateTime? @map("reuse_detected_at") @db.Timestamptz

  @@index([familyId])
  @@map("refresh_tokens")
}

model Course {
  id                            Int       @id @default(autoincrement())
  publicId                      String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  organizationId                Int       @map("organization_id")
  title                         String    @db.VarChar(200)
  description                   String?
  accessMode                    String    @default("free") @map("access_mode") @db.VarChar(20)
  status                        String    @default("draft") @db.VarChar(20)
  primaryInstructorMembershipId Int?      @map("primary_instructor_membership_id")
  createdAt                     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                     DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("courses")
}

model Enrollment {
  id                Int       @id @default(autoincrement())
  organizationId    Int       @map("organization_id")
  userId            Int       @map("user_id")
  courseId          Int       @map("course_id")
  status            String    @default("active") @db.VarChar(20)
  entitlementSource String    @default("manual") @map("entitlement_source") @db.VarChar(30)
  enrolledAt        DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([id, organizationId])
  @@map("enrollments")
}

model UploadedFile {
  id              Int       @id @default(autoincrement())
  publicId        String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  organizationId  Int?      @map("organization_id")
  ownerUserId     Int       @map("owner_user_id")
  filePurpose     String    @map("file_purpose") @db.VarChar(30)
  originalName    String    @map("original_name") @db.VarChar(255)
  storageProvider String    @map("storage_provider") @db.VarChar(50)
  storageBucket   String    @map("storage_bucket") @db.VarChar(255)
  storageKey      String    @map("storage_key") @db.VarChar(500)
  mimeType        String    @map("mime_type") @db.VarChar(100)
  fileSizeBytes   BigInt    @map("file_size_bytes")
  checksum        String?   @db.VarChar(128)
  scanStatus      String    @default("pending") @map("scan_status") @db.VarChar(20)
  scannedAt       DateTime? @map("scanned_at") @db.Timestamptz
  isPublic        Boolean   @default(false) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([storageProvider, storageBucket, storageKey])
  @@unique([id, organizationId])
  @@map("uploaded_files")
}
